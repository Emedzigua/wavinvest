# Copy this file to .env.local and fill in the values.

# Your live domain — used for canonical URLs, hreflang, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://www.wavinvest.eu

# Supabase (database + admin login). Project settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Random secret shared with the database so quote requests can only come through this website.
# Generate: openssl rand -hex 32 — then store its SHA-256 in Supabase (see supabase/README.md).
QUOTE_FORM_SECRET=

# Cloudflare Turnstile captcha (free): https://dash.cloudflare.com → Turnstile → Add widget.
# Protects the quote form and the admin login. Leave empty only for local development.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: email notification for every new quote request (https://resend.com, free 3,000/month).
# Works once the domain is verified in Resend.
RESEND_API_KEY=
RESEND_FROM="WAV Invest <web@wavinvest.eu>"
QUOTE_NOTIFY_EMAIL=info@wavinvest.eu

# Optional: Google Analytics 4 ID (G-XXXXXXX). Only loads after a visitor accepts analytics cookies.
NEXT_PUBLIC_GA_ID=
